# EditorConfig — consistent editor behaviour across contributors.
# Most modern editors respect this file. See https://editorconfig.org/

root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
# Markdown — preserve trailing whitespace because two-space-newline
# is meaningful in Markdown.
trim_trailing_whitespace = false

[*.{yml,yaml}]
# YAML — two-space indent matches the project's existing files.
indent_size = 2

[*.py]
indent_size = 4
