# Normalise line endings on commit. Working tree gets platform-native
# line endings on checkout. This is the standard cross-platform setup
# for repos with mixed Windows / Linux / macOS contributors.

* text=auto eol=lf

# Explicitly LF for text formats — these should never be CRLF
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf
*.json      text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.js        text eol=lf
*.ts        text eol=lf
*.jsx       text eol=lf
*.tsx       text eol=lf
*.py        text eol=lf
*.sh        text eol=lf
*.toml      text eol=lf

# Binary files — don't touch
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.svg       text eol=lf
*.pdf       binary
*.zip       binary
*.gz        binary
