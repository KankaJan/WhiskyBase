---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadCasks, type Cask } from '../../lib/data';

const casks = loadCasks();

const CATEGORY_ORDER = [
  'bourbon',
  'sherry',
  'fortified',
  'wine',
  'virgin',
  'beer',
  'rum',
  'other',
  'undisclosed',
];

const CATEGORY_LABELS: Record<string, string> = {
  bourbon: 'Bourbon',
  sherry: 'Sherry',
  fortified: 'Fortified (port, madeira, marsala)',
  wine: 'Wine',
  virgin: 'Virgin oak',
  beer: 'Beer / stout',
  rum: 'Rum',
  other: 'Other',
  undisclosed: 'Undisclosed (producer-secret)',
};

const grouped: Record<string, Cask[]> = {};
for (const c of casks) {
  const cat = c.category ?? 'other';
  (grouped[cat] = grouped[cat] ?? []).push(c);
}

const orderedKeys = [
  ...CATEGORY_ORDER.filter((c) => grouped[c]),
  ...Object.keys(grouped)
    .filter((k) => !CATEGORY_ORDER.includes(k))
    .sort(),
];

function fmtVolume(v: Cask['typical_volume_litres']): string {
  if (v === null || v === undefined) return '—';
  if (Array.isArray(v)) return `${v[0]}–${v[1]} L`;
  return `${v} L`;
}
---

<BaseLayout
  title="Casks by category"
  description="Cask types grouped by category: bourbon, sherry, fortified, wine, virgin, undisclosed."
  indexable={false}
>
  <article class="content">
    <p class="breadcrumb"><a href={`${import.meta.env.BASE_URL}explore/`}>Explore</a> ›</p>
    <h1>Casks by category</h1>
    <p class="lede">
      {casks.length} cask types across {orderedKeys.length} categories.
      Casks where the producer deliberately withholds provenance
      (e.g. "refill sherry of undisclosed origin") are grouped
      under Undisclosed; this is recorded as the producer's
      stated policy, not the project's failure to research.
    </p>

    {orderedKeys.map((cat) => (
      <section>
        <h2>{CATEGORY_LABELS[cat] ?? cat} ({grouped[cat].length})</h2>
        <table>
          <thead>
            <tr>
              <th>Cask</th>
              <th>Subcategory</th>
              <th>Wood</th>
              <th class="vol-col">Volume</th>
            </tr>
          </thead>
          <tbody>
            {grouped[cat].map((c) => (
              <tr>
                <td><a href={`${import.meta.env.BASE_URL}casks/${c.id}/`}>{c.name}</a></td>
                <td>{c.subcategory ?? '—'}</td>
                <td>{c.wood_species ?? '—'}</td>
                <td class="vol-col">{fmtVolume(c.typical_volume_litres)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    ))}
  </article>
</BaseLayout>

<style>
  .content { max-width: var(--site-max-width); margin: 0 auto; }
  .breadcrumb { font-size: 0.9rem; color: var(--muted-color); margin: 0 0 0.5rem; }
  .lede { color: var(--muted-color); font-style: italic; }
  table { width: 100%; }
  .vol-col { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
</style>
