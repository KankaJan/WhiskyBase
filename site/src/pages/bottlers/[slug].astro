---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntityHeader from '../../components/EntityHeader.astro';
import OwnershipHistory from '../../components/OwnershipHistory.astro';
import SourcesBlock from '../../components/SourcesBlock.astro';
import { loadBottlers, loadBottler } from '../../lib/data';
import { renderMarkdown, renderInline, collectSourceIds } from '../../lib/markdown';

export async function getStaticPaths() {
  const bottlers = loadBottlers();
  return bottlers.map((b) => ({ params: { slug: b.id } }));
}

const { slug } = Astro.params;
if (!slug) throw new Error('Missing slug param');
const bottler = loadBottler(slug);
if (!bottler) throw new Error(`Bottler not found: ${slug}`);

const sourceIds = collectSourceIds(bottler.sources);
const descHtml = renderMarkdown(bottler.description, sourceIds);

const typeLabel = bottler.type === 'independent_bottler'
  ? 'Independent bottler'
  : 'Distillery bottling operation';
---

<BaseLayout title={bottler.name} description={bottler.description?.split('\n')[0]?.slice(0, 150)}>
  <article class="page">
    <EntityHeader
      name={bottler.name}
      entityType={typeLabel}
      status={bottler.status}
      confidence={bottler.confidence}
      lastReviewed={bottler.last_reviewed}
    />

    {(bottler.country || bottler.locality || bottler.founded) && (
      <section>
        <h2>Identity</h2>
        <dl>
          {bottler.country && (<><dt>Country</dt><dd>{bottler.country}</dd></>)}
          {bottler.region && (<><dt>Region</dt><dd>{bottler.region}</dd></>)}
          {bottler.locality && (<><dt>Locality</dt><dd>{bottler.locality}</dd></>)}
          {bottler.founded && (<><dt>Founded</dt><dd>{bottler.founded}</dd></>)}
          {bottler.website && (<><dt>Website</dt><dd><a href={bottler.website}>{bottler.website}</a></dd></>)}
        </dl>
      </section>
    )}

    {descHtml && (
      <section class="description">
        <div set:html={descHtml} />
      </section>
    )}

    {bottler.ownership && <OwnershipHistory ownership={bottler.ownership} />}

    {bottler.release_types && bottler.release_types.length > 0 && (
      <section>
        <h2>Release types</h2>
        <p>{bottler.release_types.map((t) => t.replace(/_/g, ' ')).join(', ')}</p>
      </section>
    )}

    {bottler.series && bottler.series.length > 0 && (
      <section>
        <h2>Series</h2>
        <div class="series-list">
          {bottler.series.map((s) => (
            <article class="series-item">
              <h3>{s.name ?? s.id}</h3>
              {s.description && <p set:html={renderInline(s.description, sourceIds)} />}
              <dl>
                {s.first_released && (<><dt>First released</dt><dd>{s.first_released}</dd></>)}
                {s.active !== null && s.active !== undefined && (<><dt>Active</dt><dd>{s.active ? 'yes' : 'no'}</dd></>)}
                {s.parent && (<><dt>Parent series</dt><dd><code>{s.parent}</code></dd></>)}
              </dl>
              {s.presentation_defaults && (
                <div class="defaults">
                  <strong>Presentation defaults:</strong>{' '}
                  {[
                    s.presentation_defaults.cask_strength && 'cask strength',
                    s.presentation_defaults.non_chill_filtered && 'NCF',
                    s.presentation_defaults.natural_colour && 'natural colour',
                    s.presentation_defaults.batch_or_cask_type,
                    s.presentation_defaults.abv ? `${s.presentation_defaults.abv}% ABV` : null,
                  ].filter(Boolean).join(' · ')}
                </div>
              )}
            </article>
          ))}
        </div>
      </section>
    )}

    {bottler.sources && bottler.sources.length > 0 && (
      <SourcesBlock sources={bottler.sources} />
    )}
  </article>
</BaseLayout>

<style>
  .page { max-width: var(--site-max-width); margin: 0 auto; }
  .description :global(p) { margin: 0.5rem 0; }
  .series-list { display: flex; flex-direction: column; gap: 1rem; }
  .series-item {
    padding: 0.75rem 1rem;
    border-left: 3px solid var(--rule-color);
    background: var(--bg-alt);
  }
  .series-item h3 { margin: 0 0 0.4rem; }
  .series-item dl { margin: 0.3rem 0; }
  .defaults { font-size: 0.9rem; color: var(--muted-color); margin-top: 0.4rem; }
</style>
