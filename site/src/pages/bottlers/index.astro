---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadBottlers } from '../../lib/data';

const bottlers = loadBottlers();
---

<BaseLayout title="Bottlers">
  <article class="content">
    <h1>Bottlers</h1>
    <p class="lede">
      {bottlers.length} commercial bottling entities — independent
      bottlers and distillery bottling operations.
    </p>
    <ul class="list">
      {bottlers.map((b) => (
        <li>
          <a href={`/bottlers/${b.id}/`}><strong>{b.name}</strong></a>
          {b.country && <span class="meta"> · {b.country}</span>}
          {b.founded && <span class="meta"> · founded {b.founded}</span>}
          {b.description && <p class="summary">{b.description.split('\n')[0]?.slice(0, 200)}{b.description.length > 200 ? '…' : ''}</p>}
        </li>
      ))}
    </ul>
  </article>
</BaseLayout>

<style>
  .content { max-width: var(--site-max-width); margin: 0 auto; }
  h1 { font-size: 1.8rem; font-weight: 600; margin: 0 0 0.3rem; }
  .lede { color: var(--muted-color); margin: 0 0 1rem; }
  .list { list-style: none; padding: 0; margin: 0; }
  .list li { padding: 0.6rem 0; border-bottom: 1px solid var(--rule-light); }
  .list li:last-child { border-bottom: 0; }
  .meta { color: var(--muted-color); font-size: 0.9rem; }
  .summary { color: var(--muted-color); font-size: 0.9rem; margin: 0.25rem 0 0; }
</style>
