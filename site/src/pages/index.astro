---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntityCounts } from '../lib/data';
import { REFERENCES } from '../lib/references';

const counts = getEntityCounts();
const referenceCount = REFERENCES.length;
---

<BaseLayout
  title="Home"
  description="An open-source educational reference for Scotch whisky production, tasting, and analysis."
>
  <article class="content">
    <h1>WhiskyBase</h1>

    <p class="lede">
      A structured, fact-grounded reference for how Scotch whisky
      is made and how specific releases compare.
    </p>

    <section>
      <h2>Currently populated</h2>
      <table class="populated">
        <thead>
          <tr>
            <th>Topic</th>
            <th>Description</th>
            <th class="count-col">Count</th>
          </tr>
        </thead>
        <tbody>
          {counts.map((c) => (
            <tr>
              <td><a href={c.href}>{c.topic}</a></td>
              <td>{c.description}</td>
              <td class="count-col">{c.count}</td>
            </tr>
          ))}
          <tr>
            <td><a href={`${import.meta.env.BASE_URL}reference/`}>Reference</a></td>
            <td>Project policies, design notes, and about pages.</td>
            <td class="count-col">{referenceCount}</td>
          </tr>
        </tbody>
      </table>
    </section>

    <section>
      <h2>Map and cross-cutting views</h2>
      <p>
        <a href={`${import.meta.env.BASE_URL}map/`}>Map</a> — distilleries plotted by published
        coordinates, click a pin to open the distillery page.
      </p>
      <p>
        <a href={`${import.meta.env.BASE_URL}explore/`}>Explore</a> the same entries through
        different facets — distilleries by region or ownership,
        production lines by peating level, bottlings by presentation
        (cask strength, NCF, natural colour, single cask), or casks
        by category.
      </p>
    </section>

    <section>
      <h2>Search</h2>
      <p>
        <a href={`${import.meta.env.BASE_URL}search/`}>Full-text search</a> covers every detail
        page on the site (distilleries, production lines, bottlings,
        bottlers, casks, suppliers, reference concepts, and the
        policy pages). Filter by entity type with the dropdown after
        running a query.
      </p>
    </section>
  </article>
</BaseLayout>

<style>
  .content {
    max-width: var(--site-max-width);
    margin: 0 auto;
  }
  h1 {
    font-size: 2rem;
    margin: 0 0 0.3rem;
    font-weight: 600;
  }
  .lede {
    font-size: 1.05rem;
    color: var(--muted-color);
    margin: 0 0 1.5rem;
  }
  .populated {
    width: 100%;
  }
  .count-col {
    text-align: right;
    font-variant-numeric: tabular-nums;
    width: 4rem;
  }
  .hint {
    color: var(--muted-color);
    font-size: 0.875rem;
  }
</style>
