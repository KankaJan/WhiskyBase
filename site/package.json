{
  "name": "whiskybase-site",
  "version": "0.1.0",
  "private": true,
  "description": "Static-site frontend for the WhiskyBase Scotch whisky reference. MIT-licensed code; consumes the CC-BY-SA-4.0 data layer at /data/.",
